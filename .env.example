# ---- TerraShield AI configuration (copy to .env) ----

# Earth Engine -------------------------------------------------
# Leave blank to run in DEMO mode (synthetic layers, no GEE needed).
TERRASHIELD_GEE_PROJECT=
# Path to a GEE service-account JSON key (for CI / Cloud Run). Optional.
TERRASHIELD_GEE_SA_KEY=

# Backend ------------------------------------------------------
TERRASHIELD_ENV=development            # development | production
TERRASHIELD_LOG_LEVEL=INFO
TERRASHIELD_CORS_ORIGINS=http://localhost:3000
TERRASHIELD_CACHE_TTL_SECONDS=900
TERRASHIELD_RATE_LIMIT_PER_MIN=60

# GeoCopilot (optional, for Phase 4) ---------------------------
# Provider for LLM summaries: openai | groq | none
TERRASHIELD_LLM_PROVIDER=none
TERRASHIELD_LLM_API_KEY=
TERRASHIELD_LLM_MODEL=

# Frontend -----------------------------------------------------
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
